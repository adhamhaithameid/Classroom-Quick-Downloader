# Oracle Backend Environment Variables
# Copy this file to .env and update values for your environment.
# DO NOT commit .env to version control.

# Basic Application Configuration
APP_ENV=development
ADDR=:8080
DB_PATH=/data/analytics.db
STATIC_DIR=/app/static

# Google Cloud Integration
GOOGLE_CREDS_PATH=/run/secrets/google-credentials.json

# Security: Required in all environments
DO_SHARED_SECRET=change-me-in-production
DASHBOARD_PASSWORD=change-me-in-production
SUPER_ADMIN_PASSWORD=change-me-in-production
ORACLE_AUDIT_CHECKPOINT_SECRET=change-me-in-production

# HTTPS & CORS Configuration
SESSION_COOKIE_SECURE=auto
PUBLIC_BASE_URL=http://localhost
CSRF_ALLOWED_ORIGINS=http://localhost

# Database (Optional: use SQLite if empty)
POSTGRES_DSN=

# Storage Watermarks (percentage)
STORAGE_WATERMARK_WARN=70
STORAGE_WATERMARK_CRITICAL=85
STORAGE_WATERMARK_EMERGENCY=92

# Data Retention
ORACLE_RETENTION_RAW_SNAPSHOTS_DAYS=30

# Disaster Recovery Configuration
ORACLE_PRIMARY_REGION=primary
ORACLE_DR_REGION=warm-dr
ORACLE_DR_REPLICA_LAG_SECONDS=-1
ORACLE_DR_PROMOTION_MAX_LAG_SECONDS=300

# Cloudflare Analytics Integration (Optional)
CLOUDFLARE_ANALYTICS_API_TOKEN=
CLOUDFLARE_ANALYTICS_ACCOUNT_TAG=
CLOUDFLARE_ANALYTICS_HOSTNAME=

# Website Traffic Sync (Optional)
ORACLE_WEBSITE_TRAFFIC_SYNC_ENABLED=false
ORACLE_WEBSITE_TRAFFIC_SYNC_INTERVAL_SECONDS=3600
ORACLE_WEBSITE_TRAFFIC_SYNC_LOOKBACK_HOURS=48

# Deployment Metadata (Set by CI/CD)
GIT_COMMIT=unknown
DEPLOY_TIME=

# Docker Caddy Proxy
ORACLE_PUBLIC_HOSTNAME=localhost
GOOGLE_CREDS_PATH_HOST=/dev/null
