# oracle-backend/.env.example
# Copy this file to .env and update all values for your environment.
# Never commit the actual .env file with secrets.

# Application environment (development, staging, production)
APP_ENV=development

# Server address
ADDR=:8080

# Database path (when using SQLite; ignored if POSTGRES_DSN is set)
DB_PATH=/data/analytics.db

# Static files directory
STATIC_DIR=/app/static

# Google credentials JSON file path (for Google Sheets export, etc.)
GOOGLE_CREDS_PATH=/run/secrets/google-credentials.json

# Cloudflare Durable Object shared secret (required)
# Used to authenticate requests from Cloudflare Workers
DO_SHARED_SECRET=change-me-to-a-strong-random-secret

# Dashboard authentication
# Change-me passwords for the admin dashboard
DASHBOARD_PASSWORD=change-me-to-secure-password
SUPER_ADMIN_PASSWORD=change-me-to-super-secure-password

# Audit/checkpoint authentication
ORACLE_AUDIT_CHECKPOINT_SECRET=change-me-to-random-secret

# HTTPS/TLS configuration
SESSION_COOKIE_SECURE=auto

# Public base URL (e.g., https://api.example.com)
PUBLIC_BASE_URL=

# CSRF allowed origins (comma-separated list)
CSRF_ALLOWED_ORIGINS=

# PostgreSQL data source name (optional; if set, overrides SQLite)
POSTGRES_DSN=

# Storage watermark percentages
STORAGE_WATERMARK_WARN=70
STORAGE_WATERMARK_CRITICAL=85
STORAGE_WATERMARK_EMERGENCY=92

# Data retention policy
ORACLE_RETENTION_RAW_SNAPSHOTS_DAYS=30

# Disaster recovery configuration
ORACLE_PRIMARY_REGION=primary
ORACLE_DR_REGION=warm-dr
ORACLE_DR_REPLICA_LAG_SECONDS=-1
ORACLE_DR_PROMOTION_MAX_LAG_SECONDS=300

# Cloudflare Analytics integration (optional)
CLOUDFLARE_ANALYTICS_API_TOKEN=
CLOUDFLARE_ANALYTICS_ACCOUNT_TAG=
CLOUDFLARE_ANALYTICS_HOSTNAME=

# Website traffic sync feature
ORACLE_WEBSITE_TRAFFIC_SYNC_ENABLED=false
ORACLE_WEBSITE_TRAFFIC_SYNC_INTERVAL_SECONDS=3600
ORACLE_WEBSITE_TRAFFIC_SYNC_LOOKBACK_HOURS=48

# Build metadata (auto-populated during deployment)
GIT_COMMIT=unknown
DEPLOY_TIME=
