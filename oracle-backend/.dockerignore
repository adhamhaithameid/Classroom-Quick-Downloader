# oracle-backend/.dockerignore
# Exclude unnecessary files from Docker build context

# Version control
.git
.gitignore
.github

# Dependencies
node_modules
pnpm-lock.yaml
package-lock.json

# Test files and coverage
tests
*.test.ts
*.test.js
coverage
.nyc_output

# Database and data files
*.db
*.sqlite
data/
*.log

# Documentation
docs/
README.md
*.md

# Development files
.env
.env.local
.env.*.local
.vscode
.idea
*.swp
*.swo

# Build outputs (keep if needed for staged builds)
# dist/
# build/

# Root-level files we don't need in container
tools/
website/
extension/
cloudflare-worker/

# Dashboard source (we use built output)
dashboard/
