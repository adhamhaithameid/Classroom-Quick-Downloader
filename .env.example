# Root .env example — manual export file for local runs of root tools.
#
# NOTHING in the repo loads this file automatically (no dotenv at the root).
# Source it yourself when a tool needs values, or export them in your shell
# profile. Production values live in GitHub Actions secrets and the
# Cloudflare dashboard — never here. Copy to .env and fill in what you need.
#
# Template recovered 2026-10-25 after the storage-clean incident. The
# original root .env was never recoverable; re-enter values from your
# records. Leave a line empty if the tool's default is fine.

# --- Indexing (tools/indexnow-*.mjs, tools/gsc-*) -------------------------
# IndexNow key shared with the deployed site (also a Pages env var as
# PUBLIC_INDEXNOW_KEY). Rotate by updating BOTH places.
INDEXNOW_KEY=
INDEXNOW_KEY_LOCATION=
INDEXNOW_ENDPOINT=
INDEXNOW_ALL_ENGINES=
PUBLIC_INDEXNOW_KEY=
PUBLIC_SITE_URL=

# --- Google Search Console (sitemap submission) ---------------------------
# Either inline JSON or a path to the service-account file.
GOOGLE_SEARCH_CONSOLE_CREDENTIALS_JSON=
GOOGLE_SEARCH_CONSOLE_CREDENTIALS_PATH=
GOOGLE_SEARCH_CONSOLE_SITE_URL=
INDEXING_STRICT=
INDEXING_DRY_RUN=

# --- Backups (tools/backup-to-sheet.mjs) ----------------------------------
GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEETS_ID=
GOOGLE_SHEETS_RANGE=

# --- Chrome Web Store (store scripts) -------------------------------------
# Desktop-client OAuth client for the refresh-token minter.
CWS_CLIENT_ID=
CWS_CLIENT_SECRET=

# --- Live capture (tools/capture-classroom-*.mjs) -------------------------
LIVE_CAPTURE_AUTHUSER=
LIVE_CHANNEL=

# --- Misc -----------------------------------------------------------------
CQD_OLD_POST_CLASS_ID=
CP_DEBUG=
