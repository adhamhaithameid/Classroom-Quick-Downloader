# Environment Variables for Development

# Optional: Path to your preferred browser for running the extension in development mode
# Leave empty to use your default Chrome installation
# Examples:
#   macOS Brave: /Applications/Brave Browser.app/Contents/MacOS/Brave Browser
#   macOS Chrome: /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
#   Windows Chrome: C:\Program Files\Google\Chrome\Application\chrome.exe
#   Linux Chrome: /usr/bin/google-chrome
VITE_DEV_BROWSER_PATH=

# Optional: Custom user data directory for development profile
# This keeps your development profile separate from your main browser profile
# Leave empty to use default temporary directory
# Example: ./.wxt/dev-profile
VITE_DEV_USER_DATA_DIR=
