{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "types": ["chrome"],
    // wxt 0.21 enables this in its generated tsconfig. It surfaces a large
    // backlog of unchecked index accesses; kept off while that is worked
    // through file by file.
    "noUncheckedIndexedAccess": false
  }
}
