{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "types": ["chrome"],
    // wxt 0.21 newly enables these in its generated tsconfig. Turning them on
    // surfaces 316 pre-existing type gaps across 68 files, so they stay off
    // until that backlog is worked through separately.
    "noUncheckedIndexedAccess": false,
    "verbatimModuleSyntax": false,
    "noImplicitOverride": false
  }
}
