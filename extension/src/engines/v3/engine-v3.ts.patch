  // ========================================================================
  // API CORRELATION
  // ========================================================================

  private correlateWithApi(): void {
    const snapshot = this.latestApiSnapshot;
    if (!snapshot) {
      this.phantomPosts.clear();
      return;
    }

    const domPosts = this.v2.getTrackedPosts();
    const domPostMap = new Map(domPosts.map((p) => [p.id, p]));
    const newPhantomPosts = new Map<string, PostNode>();

    for (const submission of snapshot.submissions) {
      const existingPost = domPostMap.get(submission.id);

      if (existingPost) {
        // Submission is in DOM. Reconcile files.
        const domFileIds = new Set(existingPost.files.map((f) => f.canonicalId));

        for (const attachment of submission.attachments) {
          const canonicalId = this.getCanonicalFileId(attachment);
          if (!domFileIds.has(canonicalId)) {
            existingPost.files.push(
              this.createPhantomFileNode(attachment, canonicalId),
            );
            domFileIds.add(canonicalId);
          }
        }
      } else {
        // Submission missing from DOM. Create phantom PostNode.
        const phantomPost =
          this.phantomPosts.get(submission.id) ||
          this.createPhantomPostNode(submission.id, snapshot.context.viewKind);

        const phantomFileIds = new Set(phantomPost.files.map((f) => f.canonicalId));
        const newFiles: FileNode[] = [];

        for (const attachment of submission.attachments) {
          const canonicalId = this.getCanonicalFileId(attachment);
          if (!phantomFileIds.has(canonicalId)) {
            newFiles.push(this.createPhantomFileNode(attachment, canonicalId));
            phantomFileIds.add(canonicalId);
          } else {
            const existingFile = phantomPost.files.find(
              (f) => f.canonicalId === canonicalId,
            );
            if (existingFile) newFiles.push(existingFile);
          }
        }

        phantomPost.files = newFiles;
        phantomPost.lastScannedAt = Date.now();
        newPhantomPosts.set(submission.id, phantomPost);
      }
    }

    this.phantomPosts = newPhantomPosts;
  }

  private createPhantomPostNode(postId: string, viewKind: ViewKind): PostNode {
    const element = document.createElement('div');
    element.setAttribute('data-cqd-phantom', 'true');
    element.style.display = 'none';

    return {
      id: postId,
      element,
      viewKind,
      files: [],
      flags: null,
      lastScannedAt: Date.now(),
    };
  }

  private createPhantomFileNode(
    attachment: ClassroomApiAttachment,
    canonicalId: string,
  ): FileNode {
    const element = document.createElement('div');
    element.setAttribute('data-cqd-phantom', 'true');
    element.style.display = 'none';

    const extMatch = attachment.title.match(/\.([a-z0-9]+)$/i);
    const ext = extMatch ? extMatch[1].toLowerCase() : '';

    return {
      canonicalId,
      name: attachment.title,
      ext,
      downloadUrl: attachment.downloadUrl,
      element,
      idSource: attachment.source === 'driveFile' ? 'data-drive-id' : 'url-parse',
    };
  }

  private getCanonicalFileId(attachment: ClassroomApiAttachment): string {
    if (attachment.source === 'driveFile') {
      return `drive-${attachment.id}`;
    }

    let url = attachment.downloadUrl;
    try {
      const urlObj = new URL(url);
      urlObj.searchParams.delete('authuser');
      urlObj.searchParams.delete('u');
      urlObj.searchParams.delete('hl');
      url = urlObj.toString();
    } catch {
      // invalid URL, use as-is
    }

    let hash = 0;
    for (let i = 0; i < url.length; i++) {
      const char = url.charCodeAt(i);
      hash = (hash << 5) - hash + char;
      hash |= 0;
    }
    const hashStr = Math.abs(hash).toString(36);
    return `url-${hashStr}`;
  }
