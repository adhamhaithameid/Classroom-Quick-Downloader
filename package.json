{
  "name": "classroom-quick-downloader-monorepo",
  "version": "3.2.7",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "preinstall": "node tools/enforce-pnpm.cjs",
    "dev:ext": "pnpm --filter extension dev",
    "build:ext": "pnpm --filter extension build",
    "prepare": "husky"
  },
  "pnpm": {
    "overrides": {
      "undici": ">=7.18.2",
      "@isaacs/brace-expansion": ">=5.0.1",
      "minimatch": "^10.2.1"
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.1",
    "@commitlint/config-conventional": "^20.4.1",
    "husky": "^9.1.7"
  }
}
