// rewriteRelativeImportExtensions removed per kit-3 migration: subpath .ts imports are not rewritten (TS2877); $app/tsconfig sets allowImportingTsExtensions.
{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"sourceMap": true,
		"strict": true
	},
	"include": [
		"src",
		"vite.config.ts"
	]
}
