{
	"name": "website",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"dev:pages": "npx wrangler pages dev build",
		"build": "node ./scripts/generate-seo-files.mjs && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:smoke": "vitest run src/lib/api/publicSite.smoke.test.ts src/lib/api/changelog.test.ts",
		"test:functional": "vitest run src/lib/api/publicSite.integration.test.ts src/lib/api/publicSite.acceptance.test.ts src/lib/uninstall/feedback.component.test.ts",
		"test:unit": "vitest run src/lib/api/publicSite.test.ts src/lib/api/publicSite.coercion.test.ts src/lib/api/publicSite.massive.test.ts src/lib/api/changelog.test.ts src/lib/content/privacy.test.ts src/lib/config.test.ts src/lib/celebration/balloons/config.test.ts src/lib/celebration/balloons/engine.test.ts src/lib/analytics/websiteEvents.test.ts src/lib/api/publicSite.security.test.ts src/lib/api/publicSite.regression.test.ts",
		"test:integration": "vitest run src/lib/api/publicSite.integration.test.ts src/lib/celebration/balloons/balloons.integration.test.ts",
		"test:component": "vitest run src/lib/uninstall/feedback.component.test.ts src/lib/components/BalloonsOverlay.component.test.ts",
		"test:routes": "vitest run src/routes/layout.shell.test.ts src/routes/routes.render.test.ts",
		"test:ui": "vitest run src/lib/components/BalloonsOverlay.component.test.ts src/lib/components/AnimatedNumericText.ui.test.ts src/lib/uninstall/feedback.component.test.ts",
		"test:security": "vitest run src/lib/api/publicSite.security.test.ts src/lib/content/privacy.test.ts src/lib/uninstall/feedback.edge.test.ts",
		"test:regression": "vitest run src/lib/api/publicSite.snapshot.test.ts src/lib/api/publicSite.regression.test.ts src/lib/api/publicSite.coercion.test.ts",
		"test:load": "vitest run src/lib/api/publicSite.load-stress.test.ts",
		"test:stress": "vitest run src/lib/api/publicSite.load-stress.test.ts src/lib/analytics/websiteEvents.fuzz.test.ts",
		"test:fuzz": "vitest run src/lib/analytics/websiteEvents.fuzz.test.ts",
		"test:reliability": "vitest run src/lib/analytics/websiteEvents.reliability.test.ts src/lib/analytics/websiteEvents.test.ts src/lib/api/publicSite.snapshot.test.ts",
		"test:acceptance": "vitest run src/lib/api/publicSite.acceptance.test.ts",
		"test:system": "pnpm run test:integration && pnpm run test:component && pnpm run test:acceptance",
		"test:strict": "pnpm run test:smoke && pnpm run test:functional && pnpm run test:integration && pnpm run test:regression && pnpm run test:load && pnpm run test:stress && pnpm run test:security && pnpm run test:ui && pnpm run test:routes && pnpm run test:fuzz && pnpm run test:reliability && pnpm run test:unit && pnpm run test:acceptance && pnpm run test:system",
		"test:massive": "pnpm run check && pnpm run test:strict && pnpm run test",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@number-flow/svelte": "^0.4.0",
		"balloons-js": "^0.0.3",
		"d3-geo": "^3.1.1",
		"d3-scale": "^4.0.2",
		"iso-3166-1": "^2.1.1",
		"marked": "^17.0.4",
		"topojson-client": "^3.1.0",
		"world-atlas": "^2.0.2"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.55.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@types/d3-geo": "^3.1.0",
		"@types/d3-scale": "^4.0.9",
		"@types/topojson-client": "^3.1.5",
		"svelte": "^5.53.11",
		"svelte-check": "^4.4.5",
		"typescript": "^5.9.3",
		"vite": "^8.0.0",
		"vitest": "^4.1.0"
	},
	"overrides": {
		"cookie": "0.7.2"
	}
}
